#!/bin/sh
# Standalone, VERSION-CONTROLLED pre-commit hook for the Swing Trading repo.
# Added 2026-08-16 (audit finding ST-1): this repo holds live Alpaca
# credentials (alpaca_keys.env) but had no secret gate at all — no
# core.hooksPath, no .git/hooks/pre-commit. Activate with:
#   git config core.hooksPath scripts/git-hooks
#
# Secret gate + record invariants. NOTE (corrected 2026-09-06, audit FX LOW 10):
# this comment used to say "this repo has no HTML-twin record to keep in sync --
# don't add that job here". That was FALSE. The twin exists at
# docs/'Project Record - Full Chronological History.html', built by
# scripts/render_record_html.py, and HANDOFF states the policy: REGENERATE AFTER
# EVERY APPEND. The false instruction is why the twin drifted ten appendices
# behind. Regeneration is a HUMAN step and is deliberately NOT gated here (Evan,
# 2026-09-06) -- so nothing below blocks a commit for a stale twin. If you skip
# it, the public record's reading view silently lags the ground truth.
#
# ONE executing copy, at a fixed path, shared by every repo — do NOT inline a
# second copy here. That file resolves the scanner and owns the block/fail-open
# policy, so a gate fix lands once instead of in four forks.
# Emergency bypass: git commit --no-verify (don't make it a habit).

GATE="${HOME}/.claude/skills/commit-gate/hooks/pre-commit"
if [ -f "$GATE" ]; then
  sh "$GATE" || exit 1
else
  echo "commit-gate BLOCKED: secret gate not found at $GATE." >&2
  echo "This repo holds live Alpaca credentials, is public, and has no CI" >&2
  echo "backstop (no .github/), so this hook is the ONLY scan. It now fails" >&2
  echo "CLOSED: a machine without the gate installed does not commit." >&2
  echo "Install the commit-gate skill, or bypass deliberately with" >&2
  echo "  git commit --no-verify   (you own what that lets through)." >&2
  exit 1
fi


# ── Record invariants ────────────────────────────────────────────────────────
# DELEGATED to ONE executing copy shared by every repo with an append-only
# record, so a fix to the record rules lands once instead of in each repo's
# fork. Added 2026-08-20: this block previously existed in the Skills repo
# ALONE, so a hand-splice — the failure that silently overwrote another
# session's entry (record BT) — was blocked there and free everywhere else.
# No-op unless the record is actually staged. Fails CLOSED.
REC_GUARD="${HOME}/.claude/skills/project-memory/hooks/pre-commit-record"
if [ -f "$REC_GUARD" ]; then
  sh "$REC_GUARD" || exit 1
else
  echo "record-check WARNING: record guard not found at $REC_GUARD" >&2
  echo "  record invariants NOT verified for this commit." >&2
fi

exit 0
